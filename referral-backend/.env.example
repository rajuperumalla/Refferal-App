# ── SMTP (Gmail) ──────────────────────────────────────────────────────────────
# Gmail: enable 2FA → Google Account → Security → App Passwords → create one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=MediReferral <your-gmail@gmail.com>

# ── Firebase Admin (for Firestore mail_queue watcher) ─────────────────────────
# Go to Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the ENTIRE JSON content as a single line (escape quotes if needed)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"xlcare-partner",...}

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
